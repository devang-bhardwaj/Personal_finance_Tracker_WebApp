# Copy this file to .env and fill with your actual values

# Database Configuration
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=your_secure_password_here
DB_NAME=personal_finance_tracker

# Security Configuration
JWT_SECRET_KEY=your_jwt_secret_key_256_bits_minimum
ENCRYPTION_KEY=your_encryption_key_256_bits

# External API Keys (Optional)
BANK_API_KEY=your_bank_api_key
EMAIL_API_KEY=your_email_service_key
TWILIO_API_KEY=your_twilio_api_key

# Redis Configuration (for caching)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=your_redis_password

# Application Configuration
APP_NAME=Personal Finance Tracker
APP_VERSION=2.0.0-enterprise
APP_ENV=development
DEBUG=true

# Email Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_email_password

# AWS Configuration (if using AWS services)
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_REGION=us-east-1
AWS_S3_BUCKET=your_s3_bucket_name

# Monitoring Configuration
SENTRY_DSN=your_sentry_dsn_url
PROMETHEUS_PORT=9090